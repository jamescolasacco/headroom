<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>HeadroomServer</AssemblyName>
    <RootNamespace>Headroom.Server</RootNamespace>
    <ApplicationIcon>..\..\assets\headroom.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.1.0</Version>
    <Product>Headroom</Product>
    <Description>Headroom Server — tray icon and settings for the Headroom host</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- The WebView2 package also ships its WPF control; its WindowsBase version conflict is irrelevant to WinForms. -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\headroom.ico" LogicalName="headroom.ico" />
    <EmbeddedResource Include="..\..\assets\headroom-active.ico" LogicalName="headroom-active.ico" />
  </ItemGroup>

</Project>
