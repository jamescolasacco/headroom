<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>HeadroomServer</AssemblyName>
    <RootNamespace>Headroom.Server</RootNamespace>
    <ApplicationIcon>..\..\assets\headroom.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.4.13</Version>
    <Product>Headroom</Product>
    <Description>Headroom Server — tray icon and settings for the Headroom host</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- The WebView2 package also ships its WPF control; its WindowsBase version conflict is irrelevant to WinForms. -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\headroom.ico" LogicalName="headroom.ico" />
    <EmbeddedResource Include="..\..\assets\headroom-active.ico" LogicalName="headroom-active.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Updates: the same updater as Headroom Viewer / Headroom Server (update-windows), and the certificate releases
         must be signed with (when the repository has one: tools/make-signing-cert.sh). -->
    <Compile Include="..\..\update-windows\Updater.cs" Link="Updater.cs" />
    <Content Include="..\..\assets\headroom-signing.cer" Link="update-signing.cer" Condition="Exists('..\..\assets\headroom-signing.cer')" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <AssemblyMetadata Include="HeadroomUpdateRepo" Value="$(HeadroomUpdateRepo)" Condition="'$(HeadroomUpdateRepo)' != ''" />
  </ItemGroup>

</Project>
